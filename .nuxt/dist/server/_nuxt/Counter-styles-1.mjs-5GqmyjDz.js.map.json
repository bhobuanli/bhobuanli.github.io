{"file":"Counter-styles-1.mjs-5GqmyjDz.js","mappings":"","names":[],"sources":["../../../../app/components/Counter.vue"],"sourcesContent":["<template>\n  <div>\n    <h3>Counter: {{ count }}</h3>\n    <button @click=\"increment\">\n      Increment\n    </button>\n    <button @click=\"decrement\">\n      Decrement\n    </button>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst count = ref(0)\n\nconst increment = () => {\n  count.value++\n}\n\nconst decrement = () => {\n  count.value--\n}\n</script>\n\n<style scoped>\nbutton {\n  margin: 5px;\n}\n</style>\n"],"version":3}